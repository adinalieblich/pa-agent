# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Notion
NOTION_API_KEY=secret_your-key-here
NOTION_TASKS_DS_ID=
NOTION_PROJECTS_DS_ID=
NOTION_JOBS_DS_ID=
NOTION_BRAIN_DUMP_PAGE_ID=

# Webhook security
# Generated on first run if blank, then commit to your .env
WEBHOOK_SHARED_SECRET=

# Push notifications (ntfy.sh)
NTFY_TOPIC=your-random-topic-name

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=local
